###############################################
# Control File for FrontISTR                  #
# plate 周波数応答解析 (Frequency response)    #
#   001_eigen の固有値解析結果を参照する         #
###############################################
!VERSION
 3
##################################################
# 可視化出力をONにする場合:
#   下の2行の先頭 # を外す
#   例: #!WRITE,VISUAL -> !WRITE,VISUAL
##################################################
#!WRITE,RESULT
#!WRITE,VISUAL
#!WRITE, VISUAL, FREQUENCY=1
!SOLUTION,TYPE=DYNAMIC
##################################################
# DYNAMIC (周波数応答)                           #
#  1行目: 11, 2 （2=周波数応答モード）            #
#  2行目: 開始Hz, 終了Hz, step数, 変位計算Hz       #
#  3行目: 開始時間, 終了時間                       #
#  4行目: LOAD_CASE実部, 虚部, Rm, Rk（Rayleigh減衰）#
#  5行目: sampling数, 出力指定(2=物理空間), nodeID   #
#  6行目: モニタ(変位,速度,加速度,反力,ひずみ,応力) #
##################################################
!DYNAMIC
 11, 2
 100, 1000, 90, 1000.0
 0.0, 6.6e-5
 1, 1, 0.1, 0.0
 10, 2, 2
 1, 0, 0, 0, 0, 0
##################################################
# 固有値解析結果の読み込み (001_eigen の 0.log)    #
#  2行目: 読み込むモード範囲（1〜20）              #
##################################################
!EIGENREAD
 ../001_eigen/0.log
 1, 20
######################
# Boundary Condition #
######################
# fix グループを完全固定（DOF1〜3）
!BOUNDARY
fix, 1, 1, 0.0
fix, 2, 2, 0.0
fix, 3, 3, 0.0
#####################
# Frequency Load    #
#####################
# load 面（先端）に周期荷重、Z方向(DOF=3) 1.0、LOAD CASE=1（実部）
!FLOAD, LOAD CASE=1
load, 1, 0.0
load, 2, 0.0
load, 3, 1.0
##################
# SOLVER CONTROL #
##################
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=YES
 10000, 1
 1.0e-8, 1.0, 0.0
############
# Material #
############
# 単位系: mm-kg-s（座標がmm）
!MATERIAL, NAME=Steel
!ELASTIC, TYPE=ISOTROPIC
2.06e8, 0.29
!DENSITY
7.86e-6
#########################
# Post Process Settings #
#########################
##################################################
# 可視化出力をONにする場合:
#   下の4行の先頭 # を外す
#   これで FistrModel.vis_psf.****.pvtu/.vtu が出力される
##################################################
#!VISUAL,method=PSR
#!surface_num=1
#!surface 1
#!output_type=VTK
!END
