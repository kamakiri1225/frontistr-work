###############################################
# FrontISTR static analysis (K output test)   #
#   model: Quad4_FEM_00.inp (C3D4 -> 341)      #
#   Quad4_main.py に合わせた設定                #
#---------------------------------------------#
# 単位系: mm-ton-s（= N-mm。Quad4_main.pyと一致）#
#   長さ   : mm                                #
#   質量   : tonne,  時間: s                   #
#   ヤング率/応力 : MPa (=N/mm^2)              #
#       E=130000 MPa = 130 GPa (鋳鉄FC300)     #
#   密度   : tonne/mm^3 (7.4e-9 = 7400 kg/m^3) #
#   力     : N        CLOAD -100 = -100 N      #
#   変位   : mm                                #
#   熱膨張 : 1/K (1.2e-5)                       #
###############################################
!VERSION
 3
!WRITE,RESULT
!WRITE, VISUAL, FREQUENCY=1
!SOLUTION,TYPE=STATIC
######################
# Boundary Condition #
######################
# fix グループを完全固定（X/Y/Z）
!BOUNDARY
fix, 1, 1, 0.0
fix, 2, 2, 0.0
fix, 3, 3, 0.0
#####################
# Concentrated Load #
#####################
# force 節点(FEM_00では節点283)に X方向 -100N（Quad4_main.py の Fx=-100 に一致）
!CLOAD
force, 1, -100.0
force, 2, 0.0
force, 3, 0.0
##################
# SOLVER CONTROL #
##################
# 全体剛性行列を出力する設定:
#   DUMPTYPE=CSR  … 行列(K, BC適用後)をCSR形式でダンプ
#   DUMPEXIT=NO   … ダンプ後もそのまま解く（K も 変位 も両方得る）
#                    ※YES にするとダンプ直後に終了（Kだけ）
!SOLVER,METHOD=DIRECT,ITERLOG=NO,TIMELOG=YES, DUMPTYPE = CSR, DUMPEXIT = NO
 10000, 1
 1.0e-8, 1.0, 0.0
# --- 直接法(DIRECT)版。通常解析に戻すときはこちらを有効化 ---
#!SOLVER,METHOD=DIRECT,ITERLOG=NO,TIMELOG=YES
# 10000, 1
# 1.0e-8, 1.0, 0.0
############
# Material #
############
# FC300（弾性・密度）。mm-ton-s系：E=130000 MPa=130GPa, 密度=7.4e-9 tonne/mm^3
# ※Quad4_main.py の YOUNG=130000(MPa), POISSON=0.27 と一致
!MATERIAL, NAME=FC300
!ELASTIC, TYPE=ISOTROPIC
 130000.0, 0.27
!DENSITY
 7.4e-9
!VISUAL, method=PSR
!surface_num=1
!surface 1
!output_type=VTK
!END
