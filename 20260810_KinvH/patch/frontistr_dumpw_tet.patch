+  !> \brief DUMPW driver: solve the 6 adjoint problems K z_i = e_i for the
+  !>        Point_A / Point_O degrees of freedom, then hand the solutions Z to
+  !>        m_fstr_ass_load to accumulate Wdiff = Z^T H and write the VTK/txt output.
+  !>        The stiffness factorization from the displacement solve is reused, so
+  !>        each of the 6 solves is only a back-substitution.
+  subroutine fstr_dump_sensitivity(hecMESH, hecMESHmpc, hecMAT, hecMATmpc, fstrSOLID, ndof)
+    type(hecmwST_local_mesh), intent(inout) :: hecMESH
+    type(hecmwST_local_mesh), pointer       :: hecMESHmpc
+    type(hecmwST_matrix), intent(inout)     :: hecMAT
+    type(hecmwST_matrix), pointer           :: hecMATmpc
+    type(fstr_solid), intent(inout)         :: fstrSOLID
+    integer(kind=kint), intent(in)          :: ndof
+
+    integer(kind=kint) :: dof6(6), na_local, no_local, c, i, ntot
+    integer(kind=kint) :: ig0, ig, ityp, idofS, idofE, iS0, iE0, ik, in, idof
+    logical :: ok
+    logical, allocatable :: is_fixed(:)
+    real(kind=kreal), allocatable :: Z(:,:), saveB(:), saveX(:)
+
+    if (hecmw_comm_get_size() /= 1) then
+      if (hecmw_comm_get_rank() == 0) &
+        write(IMSG,*) 'DUMPW currently supports only a single domain.'
+      call hecmw_abort(hecmw_comm_get_comm())
+    endif
+
+    call fstr_sensitivity_read_dofs(hecMESH, dof6, na_local, no_local, ok)
+    if (.not. ok) then
+      ! sensitivity_points.dat is missing or invalid: stop the run with an error
+      ! (fstr_sensitivity_read_dofs has already printed the file name and how to write it).
+      ! Use "error stop" so the process exits with a non-zero status. DUMPW is
+      ! single-domain only, so this cannot leave other MPI ranks hanging.
+      write(IMSG,*) ' DUMPW ERROR: aborting because sensitivity_points.dat is missing or invalid.'
+      write(*,*)    ' DUMPW ERROR: aborting because sensitivity_points.dat is missing or invalid.'
+      error stop 1
+    endif
+
+    ntot = hecMESH%n_node*ndof
+    allocate(Z(ntot,6), saveB(size(hecMAT%B)), saveX(size(hecMAT%X)))
+    saveB(:) = hecMAT%B(:)
+    saveX(:) = hecMAT%X(:)
+
+    ! reuse the existing factorization: skip symbolic and numeric factorization
+    hecMATmpc%Iarray(97) = 0
+    hecMATmpc%Iarray(98) = 0
+
+    ! K has already been dumped once during the displacement solve; suppress the
+    ! per-solve matrix dump so the 6 adjoint solves do not re-dump K each time.
+    call hecmw_mat_set_dump(hecMATmpc, 0)
+
+    do c = 1, 6
+      hecMAT%B(:) = 0.0d0
+      hecMAT%B(dof6(c)) = 1.0d0
+      call hecmw_mpc_trans_rhs(hecMESH, hecMAT, hecMATmpc)
+      hecMATmpc%X = 0.0d0
+      call solve_LINEQ(hecMESHmpc, hecMATmpc)
+      call hecmw_mpc_tback_sol(hecMESH, hecMAT, hecMATmpc)
+      do i = 1, ntot
+        Z(i,c) = hecMAT%X(i)
+      enddo
+    enddo
+
+    ! ----- zero the adjoint solutions at prescribed (fixed) DOFs -----
+    ! A constrained DOF cannot move, so its displacement sensitivity is zero.
+    ! With the penalty/elimination BC the raw solve leaves a spurious value at a
+    ! DOF whose own point is fixed (e.g. Point_O on the fixed boundary); dropping
+    ! the fixed-DOF rows of Z removes it, matching K^-1 applied to the BC system.
+    allocate(is_fixed(ntot))
+    is_fixed(:) = .false.
+    do ig0 = 1, fstrSOLID%BOUNDARY_ngrp_tot
+      ig    = fstrSOLID%BOUNDARY_ngrp_ID(ig0)
+      ityp  = fstrSOLID%BOUNDARY_ngrp_type(ig0)
+      idofS = ityp/10
+      idofE = ityp - idofS*10
+      iS0 = hecMESH%node_group%grp_index(ig-1) + 1
+      iE0 = hecMESH%node_group%grp_index(ig)
+      do ik = iS0, iE0
+        in = hecMESH%node_group%grp_item(ik)
+        do idof = idofS, idofE
+          if (idof >= 1 .and. idof <= ndof) is_fixed(ndof*(in-1)+idof) = .true.
+        enddo
+      enddo
+    enddo
+    do i = 1, ntot
+      if (is_fixed(i)) Z(i,:) = 0.0d0
+    enddo
+    deallocate(is_fixed)
+
+    call fstr_sensitivity_export(hecMESH, fstrSOLID, Z)
+
+    ! restore the RHS / solution so downstream post-processing is unaffected
+    hecMAT%B(:) = saveB(:)
+    hecMAT%X(:) = saveX(:)
+    deallocate(Z, saveB, saveX)
+  end subroutine fstr_dump_sensitivity
+
