############################################################
# Direct H matrix export for Quad4_FEM_Tji.inp (570 nodes)  #
# Element type: 341 (first-order tetrahedron)                #
# Comparison target: post/python_H_tji.py, sample/002_.../   #
#                     ThermoSenseAnalyzer_standalone.py      #
############################################################
!VERSION
 3
!SOLUTION,TYPE=STATIC
!BOUNDARY
 fix, 1, 3, 0.0
!TEMPERATURE
 19, 1.0
############################################################
# DUMPH=YES     : output H_matrix.mtx (all columns)
# DUMPTYPE=MM   : also output K in Matrix Market
# DUMPEXIT=YES  : stop after matrix output
############################################################
!SOLVER,METHOD=DIRECT,ITERLOG=NO,TIMELOG=YES,DUMPTYPE=MM,DUMPH=YES,DUMPEXIT=YES
 10000, 1
 1.0e-8, 1.0, 0.0
!MATERIAL, NAME=FC300
!ELASTIC, TYPE=ISOTROPIC
 130000000.0, 0.27
!DENSITY
 7.4e-06
!EXPANSION_COEFF
 1.2e-05
!END
