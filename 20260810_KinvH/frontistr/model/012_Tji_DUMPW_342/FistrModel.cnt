############################################################
# DUMPW verification for the SECOND-ORDER (342, C3D10) mesh  #
# generated from Quad4_FEM_Tji by post/convert_341_to_342.py #
#   corners 570 + mid-edge 2744 = 3314 nodes, 1699 elements  #
#                                                            #
# One fistr1 run outputs all four:                           #
#   dump_matrix_1_0.mm    K  (DUMPTYPE=MM, built-in)         #
#   H_matrix.mtx          H  (DUMPW)                          #
#   sensitivity_Wdiff.vtk W  (DUMPW, ParaView)               #
#   Wdiff_fistr.txt       W  (DUMPW, text)                    #
#                                                            #
# Point_A / Point_O are read from sensitivity_points.dat     #
# (this case: 19 103, both corner nodes).                    #
############################################################
!VERSION
 3
!SOLUTION,TYPE=STATIC
!BOUNDARY
 fix, 1, 3, 0.0
!TEMPERATURE
 19, 1.0
############################################################
# DUMPTYPE=MM : dump K in MatrixMarket (dump_matrix_1_0.mm)  #
# DUMPW=YES   : dump H and the sensitivity W (+ VTK)         #
# METHOD=DIRECT is required (factorization reuse).           #
# Do NOT set DUMPEXIT: DUMPW needs the real solve.           #
############################################################
!SOLVER,METHOD=DIRECT,ITERLOG=NO,TIMELOG=YES,DUMPTYPE=MM,DUMPW=YES
 10000, 1
 1.0e-8, 1.0, 0.0
!MATERIAL, NAME=FC300
!ELASTIC, TYPE=ISOTROPIC
 130000000.0, 0.27
!DENSITY
 7.4e-06
!EXPANSION_COEFF
 1.2e-05
!END
