###############################################
# H(温度荷重変換行列) 列抽出テスト             #
#  節点2に単位温度 -> RHSダンプ = H の 2列目    #
#  荷重なし・境界条件なし（生H列）             #
###############################################
!VERSION
 3
!WRITE,RESULT
!SOLUTION,TYPE=STATIC
######################
# 温度（節点2に単位温度）#
######################
!TEMPERATURE
 2, 1.0
##################
# SOLVER: 行列(と RHS=温度荷重) をダンプして即終了 #
##################
!SOLVER,METHOD=DIRECT,ITERLOG=NO,TIMELOG=YES, DUMPTYPE = MM, DUMPEXIT = YES
 10000, 1
 1.0e-8, 1.0, 0.0
############
# Material #
############
# mm-ton-s: E=130000 MPa, 密度 7.4e-9, 熱膨張 1.2e-5 /K
!MATERIAL, NAME=FC300
!ELASTIC, TYPE=ISOTROPIC
 130000.0, 0.27
!DENSITY
 7.4e-9
!EXPANSION_COEFF
 1.2e-5
!END
