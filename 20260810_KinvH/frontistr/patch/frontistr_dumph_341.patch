@@ -550,4 +557,81 @@ contains
     
   end subroutine calculate_thermal_load
 
+  !======================================================================!
+  !> Export f_thermal = H T for first-order tetrahedral elements (type 341).
+  !> Duplicate coordinate entries from adjacent elements are intentionally
+  !> written; Matrix Market readers sum them when constructing the matrix.
+  !======================================================================!
+  subroutine export_thermal_matrix_341(hecMESH, fstrSOLID)
+    type(hecmwST_local_mesh), intent(in) :: hecMESH
+    type(fstr_solid), intent(inout)      :: fstrSOLID
+
+    integer(kind=kint), parameter :: etype = 341, nn = 4, ndof = 3
+    integer(kind=kint), parameter :: iunit = 208
+    integer(kind=kint) :: icel, is, i, j, k, inode, isect, cdsys_ID
+    integer(kind=kint) :: n_elem_341, nentry, stat
+    integer(kind=kint) :: nodLocal(nn)
+    real(kind=kreal) :: xx(nn), yy(nn), zz(nn), tt(nn), tt0(nn)
+    real(kind=kreal) :: vect(nn*ndof), coords(3,3)
+
+    if (hecmw_comm_get_size() /= 1) then
+      if (hecmw_comm_get_rank() == 0) then
+        write(IMSG,*) 'DUMPH currently supports only a single domain.'
+      endif
+      call hecmw_abort(hecmw_comm_get_comm())
+    endif
+
+    n_elem_341 = 0
+    do icel = 1, hecMESH%n_elem
+      if (hecMESH%elem_type(icel) /= etype) cycle
+      if (fstrSOLID%elements(icel)%elemact_flag == kELACT_INACTIVE) cycle
+      n_elem_341 = n_elem_341 + 1
+    enddo
+    nentry = n_elem_341 * nn * ndof * nn
+
+    open(iunit, file='H_matrix.mtx', status='replace', iostat=stat)
+    if (stat /= 0) then
+      write(IMSG,*) 'DUMPH: cannot open H_matrix.mtx'
+      call hecmw_abort(hecmw_comm_get_comm())
+    endif
+    write(iunit,'(A)') '%%MatrixMarket matrix coordinate real general'
+    write(iunit,"(A)") '% Thermal load matrix: f_thermal = H * T'
+    write(iunit,"(I0,' ',I0,' ',I0)") hecMESH%n_node*ndof, hecMESH%n_node, nentry
+
+    tt0(:) = 0.0d0
+    do icel = 1, hecMESH%n_elem
+      if (hecMESH%elem_type(icel) /= etype) cycle
+      if (fstrSOLID%elements(icel)%elemact_flag == kELACT_INACTIVE) cycle
+
+      is = hecMESH%elem_node_index(icel-1)
+      do j = 1, nn
+        nodLocal(j) = hecMESH%elem_node_item(is+j)
+        inode = nodLocal(j)
+        xx(j) = hecMESH%node(3*inode-2)
+        yy(j) = hecMESH%node(3*inode-1)
+        zz(j) = hecMESH%node(3*inode)
+      enddo
+
+      isect = hecMESH%section_ID(icel)
+      cdsys_ID = hecMESH%section%sect_orien_ID(isect)
+      call get_coordsys(cdsys_ID, hecMESH, fstrSOLID, coords)
+
+      do k = 1, nn
+        tt(:) = 0.0d0
+        tt(k) = 1.0d0
+        call TLOAD_C3(etype, nn, xx, yy, zz, tt, tt0, &
+          fstrSOLID%elements(icel)%gausses, vect, cdsys_ID, coords)
+        do j = 1, nn
+          do i = 1, ndof
+            write(iunit,"(I0,' ',I0,' ',e20.12e3)") &
+              ndof*(nodLocal(j)-1)+i, nodLocal(k), vect(ndof*(j-1)+i)
+          enddo
+        enddo
+      enddo
+    enddo
+    close(iunit)
+    write(IMSG,*) 'DUMPH: wrote H_matrix.mtx, shape=', &
+      hecMESH%n_node*ndof, hecMESH%n_node
+  end subroutine export_thermal_matrix_341
+
 end module m_fstr_ass_load
