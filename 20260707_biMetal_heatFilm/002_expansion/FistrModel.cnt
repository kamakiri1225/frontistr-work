###############################################
# Control File for FrontISTR                  #
# heatFilm Step2: 熱伝導解析結果を読み込む熱応力解析 #
###############################################
!VERSION
 3
####################
# Analysis Control #
####################
!WRITE,VISUAL
!WRITE,RESULT
!SOLUTION,TYPE=STATIC
!STATIC
##################
# SOLVER CONTROL #
##################
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=YES
 20000, 2
 1.00000e-06, 1.00000, 0.00000
 0.100000, 0.100000
##################
# Output Control #
##################
!OUTPUT_RES
DISP, ON
NMISES, ON
NSTRESS, ON
EMISES, ON
TEMP, ON
!OUTPUT_VIS
DISP, ON
NMISES, ON
NSTRESS, ON
EMISES, ON
TEMP, ON
######################
# Boundary Condition #
######################
!BOUNDARY, GRPID=1
fix, 1, 1, 0.0
fix, 2, 2, 0.0
fix, 3, 3, 0.0
###############################################
# Temperature: Step1(heatFilm)の結果を読み込む #
###############################################
!TEMPERATURE, READRESULT=1, SSTEP=1
!REFTEMP
293
############
# Material #
############
# ELASTIC/DENSITY/EXPANSION_COEFFはFistrModel.mshに埋め込み済みのため
# ここでは再定義不要（Aluminum/Steel共通）
#############################################
# STEP Settings for FrontSTR Ver.3 or later #
#############################################
#########################
# Post Process Settings #
#########################
!VISUAL, method=PSR
!surface_num=1
!surface
!display_method=1
!surface_style=1
!initial_style=1
!output_type = VTK
!x_resolution = 800
!y_resolution = 600
!num_of_lights = 1
!position_of_lights = 100.000, 100.000, 50.0000
!up_direction = 0.00000, 0.00000, 1.00000
!ambient_coef = 0.3
!diffuse_coef = 0.7
!specular_coef = 0.5
!color_mapping_bar_on = 1
!scale_marking_on = 1
!num_of_scale = 3
!font_size = 1.5
!font_color = 1.00000, 1.00000, 1.00000
!background_color = 0.00000, 0.00000, 0.00000
!END
