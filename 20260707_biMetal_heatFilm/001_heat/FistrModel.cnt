###############################################
# Control File for FrontISTR                  #
# heatFilm: 定常熱伝導解析（膜熱伝達境界条件） #
###############################################
!VERSION
 3
####################
# Analysis Control #
####################
!WRITE,VISUAL
!WRITE,RESULT
!SOLUTION,TYPE=HEAT
!HEAT
 0.0
##################
# SOLVER CONTROL #
##################
!SOLVER,METHOD=CG,PRECOND=1,ITERLOG=NO,TIMELOG=YES
 20000, 2
 1.00000e-06, 1.00000, 0.00000
##################
# Output Control #
##################
!OUTPUT_RES
TEMP, ON
!OUTPUT_VIS
TEMP, ON
######################
# Boundary Condition #
######################
# press面（上面全体）に対流熱伝達（フィルム）境界条件を設定
# 面グループ名, 熱伝達率[W/m^2K], 周囲温度[K]
!SFILM
press, 100.0, 293.0
# otherS面（press以外の全面：側面・底面・両端面）は境界条件なし=断熱

# 熱源：load面（X=0.2の先端、ノードグループ）を固定温度373Kにする
# これがないとpress面の対流だけでは温度勾配が生まれず、定常解が293Kで一様になってしまう
!FIXTEMP
load, 373.0

############
# Material #
############
# 熱伝導率は仮の一般値（要確認・要調整）
!MATERIAL, NAME=Aluminum
!CONDUCTIVITY, TYPE=ISOTROPIC
237.0

!MATERIAL, NAME=Steel
!CONDUCTIVITY, TYPE=ISOTROPIC
50.0

#############################################
# STEP Settings for FrontSTR Ver.3 or later #
#############################################
#########################
# Post Process Settings #
#########################
!VISUAL, method=PSR
!surface_num=1
!surface
!display_method=1
!surface_style=1
!initial_style=1
!output_type = VTK
!x_resolution = 800
!y_resolution = 600
!num_of_lights = 1
!position_of_lights = 100.000, 100.000, 50.0000
!up_direction = 0.00000, 0.00000, 1.00000
!ambient_coef = 0.3
!diffuse_coef = 0.7
!specular_coef = 0.5
!color_mapping_bar_on = 1
!scale_marking_on = 1
!num_of_scale = 3
!font_size = 1.5
!font_color = 1.00000, 1.00000, 1.00000
!background_color = 0.00000, 0.00000, 0.00000
!END
